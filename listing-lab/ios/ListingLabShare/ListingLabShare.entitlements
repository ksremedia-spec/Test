<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The same group as the app and the widget. It is also the keychain
       access group the session token lives in, which is how the extension
       signs its own uploads without a second sign-in. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.horizonhomemedia.listinglab</string>
  </array>
</dict>
</plist>
